{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"C:/Users/Rundle/.local/bin/graphify.EXE\"; [ -x \"$G\" ] || G=$(command -v graphify) || exit 0; \"$G\" hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"C:/Users/Rundle/.local/bin/graphify.EXE\"; [ -x \"$G\" ] || G=$(command -v graphify) || exit 0; \"$G\" hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"C:/Users/Rundle/.local/bin/graphify.EXE\"; [ -x \"$G\" ] || G=$(command -v graphify) || exit 0; \"$G\" hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      }
    },
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "last30days@last30days-skill": true,
    "watch@claude-video": true,
    "mattpocock-skills@claude-plugins-official": true
  }
}
